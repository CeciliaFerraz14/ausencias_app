# Copia este archivo como .env y rellénalo. En Vercel, añade las mismas variables
# en Project → Settings → Environment Variables.

# Clave de la API de Anthropic (https://console.anthropic.com/settings/keys).
# Se usa solo en el servidor para leer las fotos de los horarios.
ANTHROPIC_API_KEY=

# Código que tus compañeros tendrán que escribir una vez para poder leer fotos.
# Déjalo vacío para no pedir código (cualquiera con el enlace podría gastar tu saldo).
ACCESS_CODE=
